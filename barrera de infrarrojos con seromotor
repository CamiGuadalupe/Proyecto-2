#include <Servo.h>

Servo barrera;

const int pinSensor = A0;
const int pinEmisor = 3;
const int umbral = 20;

bool barreraLevantada = false;

void setup() {
  Serial.begin(9600);
  pinMode(pinEmisor, OUTPUT);
  digitalWrite(pinEmisor, HIGH); // Emisor siempre encendido
  barrera.attach(9);
  barrera.write(140); // Barrera abajo
}

void loop() {
  int lectura = analogRead(pinSensor);
  Serial.println(lectura);

  if (!barreraLevantada && lectura < umbral) {
    // Se detecta vehículo
    barrera.write(40);           // Levanta barrera
    barreraLevantada = true;
    delay(3000);                 // Espera con barrera arriba
    barrera.write(130);            // Baja barrera
  }

  // Esperar a que ya no haya vehículo para permitir nueva detección
  if (barreraLevantada && lectura >= umbral) {
    barreraLevantada = false;
  }

  delay(100);
}
