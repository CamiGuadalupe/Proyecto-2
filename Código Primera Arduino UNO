#include <Wire.h>
#include <LiquidCrystal_I2C.h>
#include <DHT.h>

// ------------------ Pines ------------------
const int pot1Pin = A0;
const int pot2Pin = A1;
const int buzzerPin = 5;

const int ledRojo = 8;
const int ledAmarillo = 9;
const int ledVerde = 10;
const int boton = 3;

#define DHTPIN 4
#define DHTTYPE DHT11

// Pines Sensor Ultrasónico 1
const int trig1 = 6;
const int echo1 = 7;
const int led1Verde = A2;
const int led1Rojo = A3;

// Pines Sensor Ultrasónico 2
const int trig2 = 11;
const int echo2 = 12;
const int led2Verde = A4;
const int led2Rojo = A5;

// ------------------ Objetos ------------------
LiquidCrystal_I2C lcd(0x27, 16, 2);
DHT dht(DHTPIN, DHTTYPE);

// ------------------ Variables Semáforo ------------------
unsigned long tiempoSemaforo = 0;
int estadoSemaforo = 0;
bool overrideBoton = false;
unsigned long tiempoOverride = 0;
bool botonPresionadoAnterior = HIGH;

// ------------------ Variables Potenciómetro ------------------
const int umbral = 50;

// ------------------ Variables DHT y LCD ------------------
unsigned long tiempoSensor = 0;
const unsigned long intervaloSensor = 2000;

// ------------------ Variables Ultrasónicos ------------------
const int umbralEstacionamiento = 10; // cm
unsigned long tiempoUltrasonico = 0;
const unsigned long intervaloUltrasonico = 500; // cada 0.5s

// ------------------ Setup ------------------
void setup() {
  Serial.begin(9600);

  pinMode(buzzerPin, OUTPUT);
  digitalWrite(buzzerPin, LOW);

  pinMode(ledRojo, OUTPUT);
  pinMode(ledAmarillo, OUTPUT);
  pinMode(ledVerde, OUTPUT);
  pinMode(boton, INPUT_PULLUP);

  pinMode(trig1, OUTPUT);
  pinMode(echo1, INPUT);
  pinMode(led1Verde, OUTPUT);
  pinMode(led1Rojo, OUTPUT);

  pinMode(trig2, OUTPUT);
  pinMode(echo2, INPUT);
  pinMode(led2Verde, OUTPUT);
  pinMode(led2Rojo, OUTPUT);

  dht.begin();
  lcd.init();
  lcd.backlight();
}

// ------------------ Función de Lectura Ultrasónica ------------------
long leerDistanciaCM(int trigPin, int echoPin) {
  digitalWrite(trigPin, LOW);
  delayMicroseconds(2);
  digitalWrite(trigPin, HIGH);
  delayMicroseconds(10);
  digitalWrite(trigPin, LOW);
  long duracion = pulseIn(echoPin, HIGH, 20000); // 20 ms timeout
  if (duracion == 0) return 999; // Error
  return duracion * 0.034 / 2;
}

// ------------------ Loop principal ------------------
void loop() {
  unsigned long tiempoActual = millis();

  // ----------- Lectura de potenciómetros -----------
  int valor1 = analogRead(pot1Pin);
  int valor2 = analogRead(pot2Pin);

  if (abs(valor1 - valor2) < umbral) {
    digitalWrite(buzzerPin, HIGH);
  } else {
    digitalWrite(buzzerPin, LOW);
  }

  // ----------- Semáforo con botón -----------
  bool estadoBoton = digitalRead(boton);

  if (!overrideBoton && botonPresionadoAnterior == HIGH && estadoBoton == LOW) {
    overrideBoton = true;
    tiempoOverride = tiempoActual;
    Serial.println("Botón presionado: override activado");
  }

  botonPresionadoAnterior = estadoBoton;

  if (overrideBoton) {
    digitalWrite(ledRojo, LOW);
    digitalWrite(ledAmarillo, LOW);
    digitalWrite(ledVerde, HIGH);

    if (tiempoActual - tiempoOverride >= 5000) {
      digitalWrite(ledVerde, LOW);
      digitalWrite(ledRojo, HIGH);
      delay(2000);
      overrideBoton = false;
      tiempoSemaforo = millis();
      estadoSemaforo = 0;
    }
  } else {
    switch (estadoSemaforo) {
      case 0:
        digitalWrite(ledRojo, HIGH);
        digitalWrite(ledAmarillo, LOW);
        digitalWrite(ledVerde, LOW);
        if (tiempoActual - tiempoSemaforo >= 4000) {
          estadoSemaforo = 1;
          tiempoSemaforo = tiempoActual;
        }
        break;
      case 1:
        digitalWrite(ledRojo, LOW);
        digitalWrite(ledAmarillo, LOW);
        digitalWrite(ledVerde, HIGH);
        if (tiempoActual - tiempoSemaforo >= 4000) {
          estadoSemaforo = 2;
          tiempoSemaforo = tiempoActual;
        }
        break;
      case 2:
        digitalWrite(ledRojo, LOW);
        digitalWrite(ledAmarillo, HIGH);
        digitalWrite(ledVerde, LOW);
        if (tiempoActual - tiempoSemaforo >= 2000) {
          estadoSemaforo = 0;
          tiempoSemaforo = tiempoActual;
        }
        break;
    }
  }

  // ----------- Lectura de temperatura y humedad -----------
  if (tiempoActual - tiempoSensor >= intervaloSensor) {
    tiempoSensor = tiempoActual;

    float temperatura = dht.readTemperature();
    float humedad = dht.readHumidity();

    lcd.clear();
    if (isnan(temperatura) || isnan(humedad)) {
      lcd.setCursor(0, 0);
      lcd.print("Error en sensor");
    } else {
      lcd.setCursor(0, 0);
      lcd.print("Temp: ");
      lcd.print(temperatura);
      lcd.print((char)223);
      lcd.print("C");

      lcd.setCursor(0, 1);
      lcd.print("Humedad: ");
      lcd.print(humedad);
      lcd.print("%");
    }
  }

  // ----------- Lectura de sensores ultrasónicos -----------
  if (tiempoActual - tiempoUltrasonico >= intervaloUltrasonico) {
    tiempoUltrasonico = tiempoActual;

    long dist1 = leerDistanciaCM(trig1, echo1);
    long dist2 = leerDistanciaCM(trig2, echo2);

    // Estacionamiento 1
    if (dist1 < umbralEstacionamiento) {
      digitalWrite(led1Rojo, HIGH);
      digitalWrite(led1Verde, LOW);
    } else {
      digitalWrite(led1Rojo, LOW);
      digitalWrite(led1Verde, HIGH);
    }

    // Estacionamiento 2
    if (dist2 < umbralEstacionamiento) {
      digitalWrite(led2Rojo, HIGH);
      digitalWrite(led2Verde, LOW);
    } else {
      digitalWrite(led2Rojo, LOW);
      digitalWrite(led2Verde, HIGH);
    }

    Serial.print("Dist1: ");
    Serial.print(dist1);
    Serial.print(" cm | Dist2: ");
    Serial.println(dist2);
  }
}
